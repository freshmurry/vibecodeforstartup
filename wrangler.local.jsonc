{
	// LOCAL SMOKE-TEST CONFIG — not used for deployment.
	// Everything runs against local emulation (miniflare): local D1/KV/R2,
	// no containers (no Docker on the build VM), no remote bindings.
	"name": "vibecodeforstartup",
	"main": "worker/index.ts",
	"compatibility_date": "2025-08-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"assets": {
		"directory": "dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
		"binding": "ASSETS"
	},
	"unsafe": {
		"bindings": [
			{
				"name": "API_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "2101",
				"simple": { "limit": 1000, "period": 60 }
			},
			{
				"name": "AUTH_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "2102",
				"simple": { "limit": 1000, "period": 60 }
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vibecodeforstartup-db",
			"database_id": "2764e03d-6f3a-4a7d-8145-82e9af1fbc9c",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CodeGeneratorAgent",
				"name": "CodeGenObject"
			},
			{
				"class_name": "DORateLimitStore",
				"name": "DORateLimitStore"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "TEMPLATES_BUCKET",
			"bucket_name": "vibecodeforstartup-templates"
		},
		{
			"binding": "APPS_BUCKET",
			"bucket_name": "vibecodeforstartup-apps"
		}
	],
	"kv_namespaces": [
		{
			"binding": "VibecoderStore",
			"id": "a49eea4c7366479190ae126b77265db6"
		}
	],
	"migrations": [
		{
			"new_sqlite_classes": [
				"CodeGeneratorAgent"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"DORateLimitStore"
			],
			"tag": "v2"
		}
	],
	"vars": {
		"TEMPLATES_REPOSITORY": "https://github.com/cloudflare/vibecodeforstartup-templates",
		"ALLOWED_EMAIL": "test@local.dev",
		"CUSTOM_DOMAIN": "localhost",
		"CUSTOM_PREVIEW_DOMAIN": "localhost",
		"APP_SERVING_MODE": "static",
		"GENERATION_KILL_SWITCH": "0",
		"MAX_SANDBOX_INSTANCES": "3",
		"SANDBOX_INSTANCE_TYPE": "basic",
		"JWT_SECRET": "local-smoke-test-secret",
		"ENTROPY_KEY": "local-smoke-test-entropy",
		"SECRETS_ENCRYPTION_KEY": "local-smoke-test-encryption-key",
		"ENVIRONMENT": "local",
		"STRIPE_PRO_MONTHLY_PRICE_ID": "",
		"STRIPE_PRO_ANNUAL_PRICE_ID": "",
		"STRIPE_TEAM_MONTHLY_PRICE_ID": "",
		"STRIPE_TEAM_ANNUAL_PRICE_ID": ""
	},
	"workers_dev": false,
	"preview_urls": false
}
