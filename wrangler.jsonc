/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	// "$schema": "node_modules/wrangler/config-schema.json",
	"name": "vibecodeforstartup",
	"main": "worker/index.ts",
	"compatibility_date": "2025-08-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// "enable_containers": false, // Temporarily disabled
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"assets": {
		"directory": "dist",
		"not_found_handling": "single-page-application",
		// run_worker_first MUST stay true: published apps are served by the
		// worker from R2 on subdomains, and asset-first serving would shadow
		// subdomain paths that collide with platform files (/, /assets/*).
		// The worker fetch handler delegates main-domain page loads to ASSETS.
		"run_worker_first": true,
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"unsafe": {
		"bindings": [
			{
				"name": "API_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "2101",
				"simple": {
					"limit": 1000,
					"period": 60
				}
			},
			{
				"name": "AUTH_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "2102",
				"simple": {
					"limit": 1000,
					"period": 60
				}
			}
		]
	},
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"images": {
		"binding": "IMAGES"
	},
	// ---------------------------------------------------------------------
	// Workers for Platforms (OPTIONAL — not enabled).
	// WfP is a SEPARATE $25/mo plan; it is NOT included in the $5 Workers
	// Paid plan, so generated apps are published as static sites from R2
	// instead (APP_SERVING_MODE=static, see worker/services/publish).
	// To enable WfP mode later, ALL of these steps are required:
	//   1. Subscribe to Workers for Platforms on the account.
	//   2. npx wrangler dispatch-namespace create vibecodeforstartup-default-namespace
	//   3. Uncomment the dispatch_namespaces block below.
	//   4. Uncomment the DISPATCH_NAMESPACE var in "vars".
	//   5. Set worker secrets CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN
	//      (token needs Workers Scripts: Edit on the dispatch namespace).
	//   6. Set APP_SERVING_MODE to "wfp".
	// ---------------------------------------------------------------------
	/* "dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "vibecodeforstartup-default-namespace",
			"remote": true
		}
	], */
	// Containers run ONLY during generation sessions (template load,
	// preview builds). Published apps are static files in R2 and never
	// execute here. Downsized to the smallest instance type and capped
	// at 3 concurrent instances so worst-case container usage stays
	// inside the Workers Paid plan's included amounts (see BUILD-LOG.md).
	"containers": [
		{
			"class_name": "UserAppSandboxService",
			"image": "./SandboxDockerfile",
			"max_instances": 3,
			"instance_type": "basic",
			"rollout_step_percentage": 100
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vibecodeforstartup-db",
			"database_id": "2764e03d-6f3a-4a7d-8145-82e9af1fbc9c",
			"migrations_dir": "migrations",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CodeGeneratorAgent",
				"name": "CodeGenObject"
			},
			{
				"class_name": "UserAppSandboxService",
				"name": "Sandbox"
			},
			{
				"class_name": "DORateLimitStore",
				"name": "DORateLimitStore"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "TEMPLATES_BUCKET",
			"bucket_name": "vibecodeforstartup-templates",
			"remote": true
		},
		{
			// Published generated apps (static mode). Create once with:
			//   npx wrangler r2 bucket create vibecodeforstartup-apps
			"binding": "APPS_BUCKET",
			"bucket_name": "vibecodeforstartup-apps",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "VibecoderStore",
			"id": "a49eea4c7366479190ae126b77265db6",
			"remote": true
		}
	],
	"migrations": [
		{
			"new_sqlite_classes": [
				"CodeGeneratorAgent"
				// "UserAppSandboxService" // Temporarily disabled (requires containers)
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"DORateLimitStore"
			],
			"tag": "v2"
		},
		{
			"new_sqlite_classes": [
				"UserAppSandboxService"
			],
			"tag": "v3"
		}
	],
	"routes": [
		{
			"pattern": "vibecodeforstartup.com",
			"custom_domain": true,
			"zone_id": "57971c3330af23f20af3ac1b47842f17"
		},
		{
			// Published apps live at <slug>.vibecodeforstartup.com.
			// Requires a proxied wildcard DNS record in the zone:
			//   *  AAAA  100::  (proxied) — one-time, see BUILD-LOG.md.
			"pattern": "*.vibecodeforstartup.com/*",
			"zone_id": "57971c3330af23f20af3ac1b47842f17"
		}
	],
	"vars": {
		"TEMPLATES_REPOSITORY": "https://github.com/cloudflare/vibecodeforstartup-templates",
		"ALLOWED_EMAIL": "lawrencemurry@yahoo.com",
		// "DISPATCH_NAMESPACE": "vibecodeforstartup-default-namespace", // Temporarily disabled
		"CLOUDFLARE_AI_GATEWAY": "vibecodeforstartup-gateway",
		"CUSTOM_DOMAIN": "vibecodeforstartup.com",
		// Generated-app serving: "static" (R2, default) or "wfp"
		// (Workers for Platforms dispatch namespace — needs the $25/mo plan).
		"APP_SERVING_MODE": "static",
		// COST KILL SWITCH: set to "1" to instantly disable generation,
		// previews, AI inference, and deploys account-wide. Fine-grained
		// caps live in D1 system_settings (see GET /api/admin/usage) and
		// can be mirrored here as GUARDRAIL_* vars (D1 wins when set).
		"GENERATION_KILL_SWITCH": "0",
		"MAX_SANDBOX_INSTANCES": "3",
		"SANDBOX_INSTANCE_TYPE": "basic",
		// Stripe price IDs — set these to your actual Stripe price IDs from the dashboard
		"STRIPE_PRO_MONTHLY_PRICE_ID": "",
		"STRIPE_PRO_ANNUAL_PRICE_ID": "",
		"STRIPE_TEAM_MONTHLY_PRICE_ID": "",
		"STRIPE_TEAM_ANNUAL_PRICE_ID": ""
		// Note: STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are secrets — set them via:
		// wrangler secret put STRIPE_SECRET_KEY
		// wrangler secret put STRIPE_WEBHOOK_SECRET
	},
	"workers_dev": true, // Enable workers.dev subdomain as fallback
	"preview_urls": false
}
